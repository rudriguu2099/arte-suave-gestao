generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  RESPONSAVEL
  ATLETA_MAIOR

  @@map("users_role_enum")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar
  email         String    @unique @db.VarChar
  password      String    @db.VarChar
  birthDate     DateTime  @db.Date
  role          Role
  isActive      Boolean   @default(true)
  isSuperAdmin  Boolean   @default(false)
  tokenVersion  Int       @default(0)
  contactEmails Json      @default("[]")
  phones        Json      @default("[]")
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  // Soft delete: toda consulta de conta ativa precisa filtrar deletedAt: null.
  deletedAt     DateTime? @db.Timestamp(6)

  student Student?  @relation("StudentAccount")
  wards   Student[] @relation("StudentGuardian")

  @@map("users")
}

model Student {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar
  birthDate  DateTime @db.Date
  emails     Json     @default("[]")
  phones     Json     @default("[]")
  groupId    String   @db.VarChar(80)
  belt       String   @default("Branca") @db.VarChar
  attendance Json     @default("[]")
  active     Boolean  @default(true)
  accountId  String?  @unique @db.Uuid
  guardianId String?  @db.Uuid

  group    SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  account  User?       @relation("StudentAccount", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  guardian User?       @relation("StudentGuardian", fields: [guardianId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("students")
}

model SchoolGroup {
  id       String    @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(80)
  name     String    @db.VarChar
  // Critério de agrupamento (RF008/RN006): faixa etária e nível técnico.
  ageRange String    @default("") @db.VarChar
  level    String    @default("") @db.VarChar
  // Dias e horários de treino: [{ weekday: 0-6 (0 = domingo), start: 'HH:MM', end: 'HH:MM' }].
  sessions Json      @default("[]")
  // Resumo legível de sessions (ex.: 'Seg/Qua 18:00-19:30'), regravado a cada alteração.
  schedule String    @db.VarChar
  active   Boolean   @default(true)
  students Student[]

  @@map("school_groups")
}
